{
  "$schema": "https://opencode.ai/config.json",
  "update": "auto",
  "plugins": [
    "@warp-dot-dev/opencode-warp@0.2.0",
    "@jacobwolf/opencode-subagent-router@0.5.0",
    "@open-pets/opencode@4.1.0"
  ],
  "policies": [
    {
      "action": "provider.use",
